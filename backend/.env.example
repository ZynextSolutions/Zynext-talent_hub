# Copy values from the repo-root .env. Backend loads that file via:
#   dotenv.config({ path: path.resolve(process.cwd(), '../.env') })
#
# Required:
#   DATABASE_URL
#   JWT_ACCESS_SECRET          (min 32 chars, distinct from refresh)
#   JWT_REFRESH_SECRET
#   JWT_ISS
#   JWT_AUD
#   CORS_ORIGINS               (comma-separated)

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cor_lms
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ISS=cor-lms
JWT_AUD=cor-lms-api
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
LOG_LEVEL=info
