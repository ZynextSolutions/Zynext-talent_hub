DATABASE_URL="postgresql://cor_lms:cor_lms_secret@localhost:5432/cor_lms?schema=public"
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars!!"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars!!"
JWT_ISS="cor-lms"
JWT_AUD="cor-lms-api"
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=604800
PORT=4000
NODE_ENV=development
API_PUBLIC_URL="http://localhost:4000"
CORS_ORIGINS="http://localhost:3000"
BCRYPT_ROUNDS=12
NEXT_PUBLIC_API_URL="/api/v1"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
ALLOW_PUBLIC_ORG_REGISTER="true"

# Production (required)
# REDIS_URL="redis://localhost:6379"
# JOB_SECRET="change-me-job-secret-16+"
# All-tenant jobs also require header X-Job-Scope: all (or pass ?organizationId=)
# ENCRYPTION_KEY=  # 32-byte base64: openssl rand -base64 32
# SENTRY_DSN=

# Optional S3-compatible storage (MinIO)
# S3_BUCKET="cor-lms"
# S3_ENDPOINT="http://localhost:9000"
# S3_REGION="us-east-1"
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_FORCE_PATH_STYLE="true"

# Platform MFA: enable from the platform console after first login. Seed leaves it off.
